{
  "name": "@cloudlet/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "generate": "openapi-typescript ../api/openapi.yaml -o src/api.gen.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "antd": "6.7.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  }
}
